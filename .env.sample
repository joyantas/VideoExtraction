# Copy locally and explicitly set a token; there is intentionally no default credential.
MODE=local
PORT=3000
DATA_DIR=./data
LOCAL_BEARER_TOKEN=
LOCAL_OWNER=local-user
# Optional comma-separated trusted browser origins; same-origin UI needs no entry.
CORS_ORIGINS=
MAX_UPLOAD_BYTES=104857600
UPLOAD_TTL_SECONDS=600
UPLOAD_WALL_SECONDS=120
MAX_DURATION_SECONDS=120
MAX_DIMENSION=4096
MAX_PIXELS=8847360
MAX_FPS=120
MAX_SAMPLE_FRAMES=6
MEDIA_WALL_SECONDS=45
LEASE_SECONDS=180
POLL_SECONDS=2
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
# Optional explicit backend factory for integrations: package.module:callable
APP_BACKEND_FACTORY=
# Azure mode: managed identity, private Blob/Queue, and single-tenant Entra access tokens.
AZURE_STORAGE_ACCOUNT=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_API_AUDIENCE=
AZURE_REQUIRED_SCOPE=Video.Analyze
# Paid inference is opt-in; missing services remain not-evaluated.
ENABLE_PAID_AI=false
# Optional Azure Speech fast transcription. Local mode explicitly uses Azure CLI login;
# hosted Azure mode uses the configured managed identity. Never store a service key.
SPEECH_ENDPOINT=
# Empty uses service language identification; otherwise comma-separated locales, e.g. en-US.
SPEECH_LOCALES=
CU_ENDPOINT=
CU_ANALYZER_ID=campaign-video-v1
CU_MODEL_DEPLOYMENTS='{}'
OCR_ENDPOINT=
SAFETY_ENDPOINT=
